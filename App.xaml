<Application x:Class="TrueTweaks.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TrueTweaks.ViewModels"
             xmlns:views="clr-namespace:TrueTweaks.Views"
             xmlns:conv="clr-namespace:TrueTweaks.Converters"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/TrueTweaksV2Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ================= CONVERTERS ================= -->
            <conv:BoolToVisibilityConverter x:Key="BoolToVisConverter" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisConverter" Invert="True" />
            <conv:StringEqualsToBoolConverter x:Key="StringEqualsConverter" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:BooleanToStringConverter x:Key="BooleanToStringConverter" />

            <!-- ================= MVVM VIEW MAPPINGS (WITH 180ms COMPOSITION MOTION) ================= -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView Style="{StaticResource SmoothViewEntranceStyle}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TweaksViewModel}">
                <views:OptimizationCenterView Style="{StaticResource SmoothViewEntranceStyle}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CleanerViewModel}">
                <views:CleanerView Style="{StaticResource SmoothViewEntranceStyle}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RestoreViewModel}">
                <views:RestoreView Style="{StaticResource SmoothViewEntranceStyle}" />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView Style="{StaticResource SmoothViewEntranceStyle}" />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
