<UserControl x:Class="TrueTweaks.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:TrueTweaks.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="940"
             Background="Transparent">

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER ================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="System Junk Cleaner" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#F3F5F8" 
                       Margin="0,0,0,4"/>
            <TextBlock Text="Purge obsolete system cache files, DirectX/Vulkan shader caches, crash dumps, and residual logs to reclaim drive space." 
                       FontSize="12.5" 
                       Foreground="#949BA6" />
        </StackPanel>

        <!-- ================= 2. CLEANABLE CATEGORIES LIST ================= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalScrollBarStyle}" />
            </ScrollViewer.Resources>
            <ItemsControl ItemsSource="{Binding CleanerItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource BentoCardStyle}"
                                Padding="20,16"
                                Margin="0,0,0,10"
                                helpers:CompositionMotion.EnableCardHover="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsSelected}" 
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center" 
                                          Margin="0,0,18,0"
                                          Cursor="Hand"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding Title}" 
                                               FontSize="14" 
                                               FontWeight="SemiBold" 
                                               Foreground="#F3F5F8" 
                                               Margin="0,0,0,3"/>
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="12" 
                                               Foreground="#949BA6" />
                                </StackPanel>

                                <Border Grid.Column="2" 
                                        Background="#161922" 
                                        BorderBrush="#262B38" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="12,6"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FormattedSize}" 
                                               FontSize="12.5" 
                                               FontWeight="Bold" 
                                               Foreground="#00FF66" 
                                               FontFamily="Cascadia Mono, JetBrains Mono, Consolas"
                                               Typography.NumeralAlignment="Tabular"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ================= 3. BOTTOM ACTION BAR ================= -->
        <Border Grid.Row="2"
                Background="#101218"
                BorderBrush="#1E222D"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,16"
                Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <TextBlock Text="Estimated space to reclaim: " FontSize="13.5" Foreground="#949BA6" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding FormattedTotalSize}" FontSize="15" FontWeight="Bold" Foreground="#00FF66" FontFamily="Cascadia Mono, JetBrains Mono, Consolas" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Run a system scan to accurately calculate junk volume before purging." FontSize="11.5" Foreground="#5E6573" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding ScanCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                            Margin="0,0,10,0"
                            Padding="18,9">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" Fill="#949BA6"/>
                            </Viewbox>
                            <TextBlock Text="Scan System" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryNeonButtonStyle}"
                            Command="{Binding CleanCommand}"
                            IsEnabled="{Binding IsCleaning, Converter={StaticResource InverseBoolConverter}}"
                            Padding="22,9">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M19.36,2.72L20.78,4.14L15.06,9.85C16.13,11.39 16.28,13.24 15.38,14.44L9.06,8.12C10.26,7.22 12.11,7.37 13.65,8.44L19.36,2.72M5.93,17.57C3.92,15.56 2.69,13.16 2.35,10.92L7.23,8.83L14.67,16.27L12.58,21.15C10.34,20.81 7.94,19.58 5.93,17.57Z" Fill="#050806"/>
                            </Viewbox>
                            <TextBlock Text="Clean System Now" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
