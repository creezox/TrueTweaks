<UserControl x:Class="TrueTweaks.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:TrueTweaks.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="940"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalScrollBarStyle}" />
        </ScrollViewer.Resources>
        <StackPanel Margin="28,20,28,24">

            <!-- Header -->
            <TextBlock Text="System Security &amp; Restore" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#F3F5F8" 
                       Margin="0,0,0,4"/>
            <TextBlock Text="Create dependable system snapshots and export registry hives before applying kernel optimizations." 
                       FontSize="12.5" 
                       Foreground="#949BA6" 
                       Margin="0,0,0,20"/>

            <!-- ================= CARD 1: VSS SYSTEM RESTORE POINT ================= -->
            <Border Style="{StaticResource BentoCardStyle}"
                    Padding="24"
                    Margin="0,0,0,16"
                    helpers:CompositionMotion.EnableCardHover="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#1400FF66" BorderBrush="#4000FF66" BorderThickness="1" Margin="0,0,14,0">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1Z" Fill="#00FF66"/>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Windows System Restore Point (VSS)" FontSize="15.5" FontWeight="SemiBold" Foreground="#F3F5F8" />
                            <TextBlock Text="Generates a native Windows snapshot allowing full rollback in case of instability." FontSize="12" Foreground="#949BA6" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Restore Point Name Input -->
                    <Grid Grid.Row="1" Margin="0,8,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Background="#08090C"
                                BorderBrush="#1E222D"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10"
                                Margin="0,0,12,0">
                            <TextBox Text="{Binding RestorePointDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="#F3F5F8"
                                     BorderThickness="0"
                                     FontSize="13"
                                     CaretBrush="#00FF66"/>
                        </Border>

                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryNeonButtonStyle}"
                                Command="{Binding CreateSystemRestorePointCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                Padding="22,10">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Fill="#050806"/>
                                </Viewbox>
                                <TextBlock Text="Create Restore Point" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2" Background="#161922" BorderBrush="#262B38" BorderThickness="1" CornerRadius="8" Padding="14,10">
                        <TextBlock Text="Recommended prior to applying advanced kernel scheduler adjustments or experimental profiles." 
                                   FontSize="11" 
                                   Foreground="#00FF66" 
                                   FontFamily="Cascadia Mono, JetBrains Mono, Consolas" />
                    </Border>
                </Grid>
            </Border>

            <!-- ================= CARD 2: REGISTRY HIVE BACKUP ================= -->
            <Border Style="{StaticResource BentoCardStyle}"
                    Padding="24"
                    Margin="0,0,0,16"
                    helpers:CompositionMotion.EnableCardHover="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#1400FF66" BorderBrush="#4000FF66" BorderThickness="1" Margin="0,0,14,0">
                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" Fill="#00FF66"/>
                            </Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="System Registry Backup" FontSize="15.5" FontWeight="SemiBold" Foreground="#F3F5F8" />
                            <TextBlock Text="Exports an exact snapshot of CPU priorities, network stacks, and scheduler keys to a standard .reg file." FontSize="12" Foreground="#949BA6" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Backup Storage Path:" FontSize="11.5" Foreground="#949BA6" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding LastBackupPath}" FontSize="12" Foreground="#00FF66" FontFamily="Cascadia Mono, JetBrains Mono, Consolas" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding BackupRegistryCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                Padding="20,10">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z" Fill="#00FF66"/>
                                </Viewbox>
                                <TextBlock Text="Export Registry Backup" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
