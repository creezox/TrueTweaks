<UserControl x:Class="TrueTweaks.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:TrueTweaks.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="940"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalScrollBarStyle}" />
        </ScrollViewer.Resources>
        <StackPanel Margin="28,20,28,24">

            <!-- Header -->
            <TextBlock Text="Application Settings" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="#F3F5F8" 
                       Margin="0,0,0,4"/>
            <TextBlock Text="Configure TrueTweaks startup preferences, synchronize optimization definitions, and manage software releases." 
                       FontSize="12.5" 
                       Foreground="#949BA6" 
                       Margin="0,0,0,20"/>

            <!-- ================= SECTION 1: SOFTWARE & ENGINE UPDATES ================= -->
            <Border Style="{StaticResource BentoCardStyle}"
                    Padding="24"
                    Margin="0,0,0,16"
                    helpers:CompositionMotion.EnableCardHover="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="SOFTWARE &amp; ENGINE UPDATES" FontSize="10.5" FontWeight="Bold" Foreground="#949BA6" FontFamily="Cascadia Mono, JetBrains Mono, Consolas"/>
                            <Border Background="#1400FF66" BorderBrush="#4000FF66" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                <TextBlock Text="AUTO-SYNC" FontSize="9.5" FontWeight="Bold" Foreground="#00FF66" FontFamily="Cascadia Mono, JetBrains Mono, Consolas"/>
                            </Border>
                        </StackPanel>
                        
                        <TextBlock Text="{Binding UpdateStatusText}" FontSize="15" FontWeight="SemiBold" Foreground="#F3F5F8" Margin="0,0,0,4"/>
                        <TextBlock Text="Channel: Production (Stable) • Architecture: 64-bit (win-x64) • Definitions Synchronized" FontSize="12" Foreground="#949BA6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryNeonButtonStyle}"
                                Command="{Binding InstallUpdateCommand}"
                                Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisConverter}}"
                                Margin="0,0,10,0"
                                Padding="18,10">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path Data="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z" Fill="#050806"/>
                                </Viewbox>
                                <TextBlock Text="Download Update" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryNeonButtonStyle}"
                                Command="{Binding UpdateAllCommand}"
                                IsEnabled="{Binding IsUpdatingAll, Converter={StaticResource InverseBoolConverter}}"
                                Margin="0,0,10,0"
                                Padding="20,10">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path Data="M11,21L12.5,13H7L14,3L12.5,11H18L11,21Z" Fill="#050806"/>
                                </Viewbox>
                                <TextBlock Text="Update System &amp; Tweaks" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding CheckUpdatesCommand}"
                                IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBoolConverter}}"
                                Padding="16,10">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Fill="#949BA6"/>
                                </Viewbox>
                                <TextBlock Text="Check" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= SECTION 2: SYSTEM PREFERENCES ================= -->
            <Border Style="{StaticResource BentoCardStyle}"
                    Padding="24"
                    Margin="0,0,0,16"
                    helpers:CompositionMotion.EnableCardHover="True">
                <StackPanel>
                    <TextBlock Text="SYSTEM PREFERENCES" FontSize="10.5" FontWeight="Bold" Foreground="#949BA6" FontFamily="Cascadia Mono, JetBrains Mono, Consolas" Margin="0,0,0,16"/>

                    <!-- Start with Windows -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Run TrueTweaks on Windows Startup" FontSize="14" FontWeight="SemiBold" Foreground="#F3F5F8" />
                            <TextBlock Text="Maintains hardware telemetry monitoring and applies active optimization profiles upon system boot." FontSize="12" Foreground="#949BA6" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Background="#1E222D" Margin="0,0,0,16" />

                    <!-- Check Updates on Startup -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Automatically Check for Updates on Startup" FontSize="14" FontWeight="SemiBold" Foreground="#F3F5F8" />
                            <TextBlock Text="Automatically verifies latest tweaks, latency algorithms, and engine definitions upon launch." FontSize="12" Foreground="#949BA6" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitchStyle}" IsChecked="{Binding CheckUpdatesOnStartup, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= SECTION 3: ABOUT TRUETWEAKS ================= -->
            <Border Style="{StaticResource BentoCardStyle}"
                    Padding="24"
                    helpers:CompositionMotion.EnableCardHover="True">
                <StackPanel>
                    <TextBlock Text="ABOUT TRUETWEAKS" FontSize="10.5" FontWeight="Bold" Foreground="#949BA6" FontFamily="Cascadia Mono, JetBrains Mono, Consolas" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse Width="56" Height="56" Margin="0,0,20,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="pack://application:,,,/Assets/logo_round.png" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TrueTweaks" FontSize="18" FontWeight="Bold" Foreground="#F3F5F8" Margin="0,0,10,0"/>
                                <Border Background="#1400FF66" BorderBrush="#4000FF66" BorderThickness="1" CornerRadius="5" Padding="7,2">
                                    <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}" FontSize="10" FontWeight="Bold" Foreground="#00FF66" FontFamily="Cascadia Mono, JetBrains Mono, Consolas"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Engineered with C# 12 / .NET 8.0 and Cyber-Precision 60 FPS Telemetry Architecture" FontSize="12" Foreground="#949BA6" Margin="0,4,0,0"/>
                            <TextBlock Text="Zero Bloatware • Instant Rollback • Windows 10 &amp; 11 Kernel Optimizer" FontSize="11.5" Foreground="#5E6573" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="#1E222D" Margin="0,0,0,16" />

                    <!-- Social / Community Links -->
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="https://github.com/creezox/TrueTweaks"
                                Margin="0,0,10,0"
                                Padding="16,9">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z" Fill="#949BA6"/>
                                </Viewbox>
                                <TextBlock Text="GitHub Repository" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryNeonButtonStyle}"
                                Command="{Binding OpenLinkCommand}"
                                CommandParameter="https://discord.gg/truetweaks"
                                Padding="18,9">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Data="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" Fill="#050806"/>
                                </Viewbox>
                                <TextBlock Text="Need Support" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
