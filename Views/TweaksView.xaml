<UserControl x:Class="TrueTweaks.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ctrl="clr-namespace:TrueTweaks.Controls"
             xmlns:helpers="clr-namespace:TrueTweaks.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="780" d:DesignWidth="980"
             Background="Transparent"
             Focusable="True">

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <!-- 1. Header & Category Filter Pills -->
            <RowDefinition Height="Auto" />
            <!-- 2. Search Bar (with Ctrl+K shortcut badge) & Engine Telemetry Counters -->
            <RowDefinition Height="Auto" />
            <!-- 3. Bento Tweak Cards Viewport + 48px Bottom Fade Mask + Floating Action Bar -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 1. HEADER & 10 CATEGORY PILLS ================= -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Optimization Center" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="#F3F5F8" 
                               Margin="0,0,0,2"/>
                    <TextBlock Text="Deploy modular kernel, registry, MSI interrupt, and network stack rules with zero-conflict exclusive preset selectors." 
                               FontSize="12.5" 
                               Foreground="#949BA6" />
                </StackPanel>
            </Grid>

            <!-- Category Pills -->
            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
                <RadioButton Content="All (200)"
                             Style="{StaticResource CategoryPillRadioStyle}"
                             Command="{Binding SetCategoryCommand}"
                             CommandParameter="ALL"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsConverter}, ConverterParameter=ALL, Mode=OneWay}" />

                <RadioButton Content="Kernel &amp; CPU (36)"
                             Style="{StaticResource CategoryPillRadioStyle}"
                             Command="{Binding SetCategoryCommand}"
                             CommandParameter="WINDOWS"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsConverter}, ConverterParameter=WINDOWS, Mode=OneWay}" />

                <RadioButton Content="Network &amp; Ping (34)"
                             Style="{StaticResource CategoryPillRadioStyle}"
                             Command="{Binding SetCategoryCommand}"
                             CommandParameter="NETWORK"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsConverter}, ConverterParameter=NETWORK, Mode=OneWay}" />

                <RadioButton Content="Services &amp; Tasks (25)"
                             Style="{StaticResource CategoryPillRadioStyle}"
                             Command="{Binding SetCategoryCommand}"
                             CommandParameter="SERVICES"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsConverter}, ConverterParameter=SERVICES, Mode=OneWay}" />

                <RadioButton Content="Hardware &amp; MSI (22)"
                             Style="{StaticResource CategoryPillRadioStyle}"
                             Command="{Binding SetCategoryCommand}"
                             CommandParameter="HARDWARE"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsConverter}, ConverterParameter=HARDWARE, Mode=OneWay}" />

                <RadioButton Content="Memory &amp; RAM (22)"
                             Style="{StaticResource CategoryPillRadioStyle}"
                             Command="{Binding SetCategoryCommand}"
                             CommandParameter="MEMORY"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsConverter}, ConverterParameter=MEMORY, Mode=OneWay}" />

                <RadioButton Content="FPS &amp; Gaming (18)"
                             Style="{StaticResource CategoryPillRadioStyle}"
                             Command="{Binding SetCategoryCommand}"
                             CommandParameter="GAMING"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsConverter}, ConverterParameter=GAMING, Mode=OneWay}" />

                <RadioButton Content="Privacy &amp; ETW (18)"
                             Style="{StaticResource CategoryPillRadioStyle}"
                             Command="{Binding SetCategoryCommand}"
                             CommandParameter="PRIVACY"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsConverter}, ConverterParameter=PRIVACY, Mode=OneWay}" />

                <RadioButton Content="Mouse &amp; USB (13)"
                             Style="{StaticResource CategoryPillRadioStyle}"
                             Command="{Binding SetCategoryCommand}"
                             CommandParameter="INPUT"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsConverter}, ConverterParameter=INPUT, Mode=OneWay}" />

                <RadioButton Content="UI &amp; Visuals (12)"
                             Style="{StaticResource CategoryPillRadioStyle}"
                             Command="{Binding SetCategoryCommand}"
                             CommandParameter="VISUALS"
                             IsChecked="{Binding SelectedCategory, Converter={StaticResource StringEqualsConverter}, ConverterParameter=VISUALS, Mode=OneWay}" />
            </WrapPanel>
        </StackPanel>

        <!-- ================= 2. TOOLBAR: INSTANT SEARCH WITH [Ctrl+K] & COUNTERS ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="520" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Instant Search Input with Explicit Placeholder & [Ctrl+K] Shortcut Badge -->
            <Border x:Name="SearchContainerBorder"
                    Grid.Column="0"
                    Background="#101218"
                    BorderBrush="#1E222D"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <Viewbox Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,10,0">
                        <Path Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" 
                              Fill="#949BA6"/>
                    </Viewbox>

                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Search 18,913 tweaks, registry keys, or latency rules... (Ctrl+K)"
                                   Foreground="#5E6573"
                                   FontSize="12.5"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInputBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchInputBox}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBox x:Name="SearchInputBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 Foreground="#F3F5F8"
                                 BorderThickness="0"
                                 FontSize="12.5"
                                 VerticalAlignment="Center"
                                 CaretBrush="#00FF66"/>
                    </Grid>

                    <!-- Keyboard Shortcut Badge [Ctrl+K] -->
                    <Border Grid.Column="2"
                            Background="#161922"
                            BorderBrush="#262B38"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,2"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Ctrl+K"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="#949BA6"
                                   FontFamily="Cascadia Mono, JetBrains Mono, Consolas" />
                    </Border>
                </Grid>
            </Border>

            <!-- Dual Counter Badges (Modules + 18,913 Engine Tweaks) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border Background="#101218" 
                        BorderBrush="#1E222D" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="12,7"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#00FF66" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AppliedCount}" FontWeight="Bold" Foreground="#00FF66" FontFamily="Cascadia Mono, JetBrains Mono, Consolas" Typography.NumeralAlignment="Tabular" FontSize="12"/>
                        <TextBlock Text=" / " Foreground="#5E6573" FontSize="12"/>
                        <TextBlock Text="{Binding TotalCount}" FontWeight="Bold" Foreground="#F3F5F8" FontFamily="Cascadia Mono, JetBrains Mono, Consolas" Typography.NumeralAlignment="Tabular" FontSize="12"/>
                        <TextBlock Text=" Modules" Foreground="#949BA6" Margin="5,0,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>

                <Border Background="#101218" 
                        BorderBrush="#1E222D" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ " Foreground="#00FF66" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding AppliedSubTweaksCount, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="#F3F5F8" FontFamily="Cascadia Mono, JetBrains Mono, Consolas" Typography.NumeralAlignment="Tabular" FontSize="12"/>
                        <TextBlock Text=" / " Foreground="#5E6573" FontSize="12"/>
                        <TextBlock Text="{Binding TotalSubTweaksCount, StringFormat={}{0:N0}}" FontWeight="Bold" Foreground="#949BA6" FontFamily="Cascadia Mono, JetBrains Mono, Consolas" Typography.NumeralAlignment="Tabular" FontSize="12"/>
                        <TextBlock Text=" Rules" Foreground="#949BA6" Margin="5,0,0,0" FontSize="12"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- ================= 3. VIEWPORT: BENTO GRID + 48px FADE MASK + FLOATING BOTTOM BAR ================= -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,0,96">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalScrollBarStyle}" />
                </ScrollViewer.Resources>

                <ItemsControl ItemsSource="{Binding FilteredTweaks}" Margin="0,0,0,96">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ctrl:ResponsiveUniformGrid MinItemWidth="390" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BentoCardStyle}"
                                    Padding="16,14"
                                    Margin="6"
                                    helpers:CompositionMotion.EnableCardHover="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}" 
                                                   FontSize="13.5" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="#F3F5F8" 
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>

                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                  IsChecked="{Binding IsApplied, Mode=TwoWay}"
                                                  Command="{Binding DataContext.ToggleTweakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"
                                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                                  Visibility="{Binding IsExclusiveGroup, Converter={StaticResource InverseBoolToVisConverter}}"
                                                  VerticalAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                Background="#1400FF66"
                                                BorderBrush="#4000FF66"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsExclusiveGroup, Converter={StaticResource BoolToVisConverter}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="#00FF66" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="EXCLUSIVE PRESETS"
                                                           FontSize="9.5"
                                                           FontWeight="Bold"
                                                           Foreground="#00FF66"
                                                           FontFamily="Cascadia Mono, JetBrains Mono, Consolas" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Border Style="{StaticResource UnifiedRegistryBadgeStyle}">
                                            <TextBlock Text="{Binding TechnicalBadge}"
                                                       Style="{StaticResource UnifiedRegistryBadgeTextStyle}" />
                                        </Border>

                                        <Border Style="{StaticResource UnifiedImpactBadgeStyle}">
                                            <TextBlock Text="{Binding LatencyBadge}"
                                                       Style="{StaticResource UnifiedImpactBadgeTextStyle}" />
                                        </Border>

                                        <Border Style="{StaticResource UnifiedSafetyBadgeStyle}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6"
                                                         Fill="{Binding RiskDotBrush}"
                                                         Margin="0,0,6,0"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding RiskDisplay}"
                                                           Style="{StaticResource UnifiedSafetyBadgeTextStyle}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Width="20" Height="20" 
                                                CornerRadius="6" 
                                                Background="#161922" 
                                                BorderBrush="#262B38" 
                                                BorderThickness="1" 
                                                Cursor="Help"
                                                VerticalAlignment="Center"
                                                Margin="0,0,0,4"
                                                ToolTipService.InitialShowDelay="100">
                                            <Border.ToolTip>
                                                <ToolTip Background="#101218" BorderBrush="#262B38" BorderThickness="1" Padding="12,8">
                                                    <StackPanel MaxWidth="390">
                                                        <TextBlock Text="{Binding SubTweaksBadge}" Foreground="#00FF66" FontSize="10.5" FontWeight="Bold" FontFamily="Cascadia Mono, JetBrains Mono, Consolas" Margin="0,0,0,4"/>
                                                        <TextBlock Text="{Binding TooltipInfo}" Foreground="#F3F5F8" FontSize="11" FontFamily="Cascadia Mono, JetBrains Mono, Consolas" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>
                                            <TextBlock Text="ℹ" FontSize="10" FontWeight="Bold" Foreground="#949BA6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </WrapPanel>

                                    <ctrl:SegmentedPillSelector Grid.Row="2"
                                                                ItemsSource="{Binding PresetOptions}"
                                                                SelectedIndex="{Binding SelectedPresetIndex, Mode=TwoWay}"
                                                                Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Visibility="{Binding IsExclusiveGroup, Converter={StaticResource BoolToVisConverter}}"
                                                                Margin="0,2,0,10" />

                                    <TextBlock Grid.Row="3"
                                               Text="{Binding Description}" 
                                               FontSize="12" 
                                               Foreground="#949BA6" 
                                               TextWrapping="Wrap"
                                               LineHeight="17"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 48px Vertical Bottom Fade Mask (Transparent -> #08090C) -->
            <Border Height="48"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,68"
                    Background="{StaticResource BottomViewportFadeMaskBrush}"
                    IsHitTestVisible="False"
                    Panel.ZIndex="10" />

            <!-- Floating Bottom Action Bar -->
            <Border VerticalAlignment="Bottom"
                    Background="#101218"
                    BorderBrush="#1E222D"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="20,14"
                    Panel.ZIndex="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity="0.65" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Ellipse Width="6" Height="6" Fill="#00FF66" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="TrueTweaks Kernel &amp; Registry Engine Ready (200 Modules • 18,913 Rules)" 
                                       FontSize="13" 
                                       FontWeight="SemiBold" 
                                       Foreground="#F3F5F8" />
                        </StackPanel>
                        <TextBlock Text="All modifications are applied asynchronously to the Windows Registry &amp; Kernel scheduler with instant rollback." 
                                   FontSize="11.5" 
                                   Foreground="#949BA6" 
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding RevertAllCommand}"
                                IsEnabled="{Binding IsApplying, Converter={StaticResource InverseBoolConverter}}"
                                Margin="0,0,10,0"
                                Padding="16,9">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path Data="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.2 3.16-1.98 5.12-1.98 3.87 0 7.07 2.75 7.82 6.4l2.42-.64C21.6 11.66 17.5 8 12.5 8z" Fill="#949BA6"/>
                                </Viewbox>
                                <TextBlock Text="Restore Defaults" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PrimaryNeonButtonStyle}"
                                Command="{Binding UpdateAllTweaksCommand}"
                                IsEnabled="{Binding IsApplying, Converter={StaticResource InverseBoolConverter}}"
                                Padding="18,9">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path Data="M11,21L12.5,13H7L14,3L12.5,11H18L11,21Z" Fill="#050806"/>
                                </Viewbox>
                                <TextBlock Text="Apply Recommended (18,913 Rules)" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
