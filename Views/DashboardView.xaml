<UserControl x:Class="TrueTweaks.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ctrl="clr-namespace:TrueTweaks.Controls"
             xmlns:helpers="clr-namespace:TrueTweaks.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="796" d:DesignWidth="1032"
             Background="Transparent">

    <!-- Proportional Grid so all cards fill 100% of the viewport height in both windowed and fullscreen modes -->
    <Grid Margin="26,18,26,22">
        <Grid.RowDefinitions>
            <!-- 1. Ultimate Tweaks Central Welcome Hero Card -->
            <RowDefinition Height="1.38*" MinHeight="168" />
            <!-- 2. "System Information" Section Title -->
            <RowDefinition Height="Auto" />
            <!-- 3. Top Bento Row: Processor & Graphics Card (2 Large Graph Cards) -->
            <RowDefinition Height="2.20*" MinHeight="220" />
            <!-- 4. Bottom Bento Row: Disk, RAM, Network (3 Cards) -->
            <RowDefinition Height="1.32*" MinHeight="140" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- 1. CENTRAL WELCOME HERO CARD ("Welcome back [user]" + Illustration)       -->
        <!-- ========================================================================= -->
        <Border Grid.Row="0"
                Background="#101218"
                BorderBrush="#1E222D"
                BorderThickness="1"
                CornerRadius="12"
                Padding="30,18"
                Margin="0,0,0,18"
                VerticalAlignment="Stretch"
                ClipToBounds="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Welcome back [user], description & Quick Boost / Restore Point actions -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock FontSize="25"
                               FontWeight="Bold"
                               Foreground="#F3F5F8"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               Margin="0,0,0,8">
                        <Run Text="Welcome back " /><Run Text="{Binding DataContext.DisplayName, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Foreground="#00FF66" />
                    </TextBlock>

                    <TextBlock Text="Optimize your Windows kernel, eliminate DPC/ISR interrupt latency, and maximize your gaming frame pacing in one click. Create a restore point anytime for instant rollback."
                               FontSize="13"
                               Foreground="#949BA6"
                               TextWrapping="Wrap"
                               LineHeight="19"
                               MaxWidth="620"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,18" />

                    <!-- Action Row (Quick Boost + Create Restore Point, no module counter pill) -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource PrimaryNeonButtonStyle}"
                                Command="{Binding QuickBoostCommand}"
                                IsEnabled="{Binding IsQuickBoosting, Converter={StaticResource InverseBoolConverter}}"
                                Height="38"
                                Padding="18,0"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡" FontSize="12.5" Foreground="#050806" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Quick Boost System →"
                                           Foreground="#050806"
                                           FontWeight="Bold"
                                           FontSize="12.5"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding CreateRestorePointCommand}"
                                IsEnabled="{Binding IsCreatingRestorePoint, Converter={StaticResource InverseBoolConverter}}"
                                Height="38"
                                Padding="16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Create Restore Point →"
                                           Foreground="#00FF66"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>

                <!-- Right Column: Meditating Gamer Hero Illustration (Seamless #101218 integration) -->
                <Border Grid.Column="1"
                        Background="#101218"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Right"
                        Margin="8,-6,-6,-6"
                        ClipToBounds="True">
                    <Image Source="pack://application:,,,/Assets/hero_illustration.png"
                           Stretch="Uniform"
                           MaxWidth="260"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>
        </Border>

        <!-- ========================================================================= -->
        <!-- 2. "SYSTEM INFORMATION" HEADER                                            -->
        <!-- ========================================================================= -->
        <TextBlock Grid.Row="1"
                   Text="System Information"
                   FontSize="16.5"
                   FontWeight="SemiBold"
                   Foreground="#F3F5F8"
                   Margin="2,0,0,12" />

        <!-- ========================================================================= -->
        <!-- 3. TOP ROW: PROCESSOR & GRAPHICS CARD (2 LARGE GRAPH CARDS)               -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= PROCESSOR CARD ================= -->
            <Border Grid.Column="0"
                    Style="{StaticResource BentoCardStyle}"
                    Padding="20,18"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Card Header: Title left, CPU Model right -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Processor"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   Foreground="#F3F5F8"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Monitor.CpuModelName}"
                                   ToolTip="{Binding Monitor.CpuModelName}"
                                   FontSize="11.5"
                                   Foreground="#949BA6"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="14,0,0,0" />
                    </Grid>

                    <!-- 4 Metric Mini-Columns with Progress Bars -->
                    <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,14">
                        <!-- Temperature -->
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Temperature" FontSize="11" Foreground="#949BA6" Margin="0,0,0,3" />
                            <TextBlock Text="46 °C"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="#F3F5F8"
                                       FontFamily="Cascadia Mono, JetBrains Mono, Consolas"
                                       Typography.NumeralAlignment="Tabular"
                                       Margin="0,0,0,6" />
                            <ProgressBar Value="46" Minimum="0" Maximum="100" Height="4"
                                         Background="#1A1E29" Foreground="#00FF66" BorderThickness="0" />
                        </StackPanel>

                        <!-- Utilization -->
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Utilization" FontSize="11" Foreground="#949BA6" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding Monitor.CpuUsage, StringFormat={}{0:F0} %}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="#F3F5F8"
                                       FontFamily="Cascadia Mono, JetBrains Mono, Consolas"
                                       Typography.NumeralAlignment="Tabular"
                                       Margin="0,0,0,6" />
                            <ProgressBar Value="{Binding Monitor.CpuUsage}" Minimum="0" Maximum="100" Height="4"
                                         Background="#1A1E29" Foreground="#00FF66" BorderThickness="0" />
                        </StackPanel>

                        <!-- Speed -->
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Speed" FontSize="11" Foreground="#949BA6" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding Monitor.CpuClockSpeed}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="#F3F5F8"
                                       FontFamily="Cascadia Mono, JetBrains Mono, Consolas"
                                       Typography.NumeralAlignment="Tabular"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,6" />
                            <ProgressBar Value="78" Minimum="0" Maximum="100" Height="4"
                                         Background="#1A1E29" Foreground="#00FF66" BorderThickness="0" />
                        </StackPanel>

                        <!-- DPC / Timer -->
                        <StackPanel>
                            <TextBlock Text="Timer Res" FontSize="11" Foreground="#949BA6" Margin="0,0,0,3" />
                            <TextBlock Text="0.50 ms"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="#00FF66"
                                       FontFamily="Cascadia Mono, JetBrains Mono, Consolas"
                                       Typography.NumeralAlignment="Tabular"
                                       Margin="0,0,0,6" />
                            <ProgressBar Value="95" Minimum="0" Maximum="100" Height="4"
                                         Background="#1A1E29" Foreground="#00FF66" BorderThickness="0" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- Live Waveform Graph (Stretches vertically with window height) -->
                    <ctrl:TaskManagerGraph Grid.Row="2"
                                           PointsSource="{Binding Monitor.CpuHistory}"
                                           VerticalAlignment="Stretch"
                                           MinHeight="80" />
                </Grid>
            </Border>

            <!-- ================= GRAPHICS CARD ================= -->
            <Border Grid.Column="2"
                    Style="{StaticResource BentoCardStyle}"
                    Padding="20,18"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Card Header: Title left, GPU Model right -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Graphics Card"
                                   FontSize="15.5"
                                   FontWeight="Bold"
                                   Foreground="#F3F5F8"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Monitor.GpuName}"
                                   ToolTip="{Binding Monitor.GpuName}"
                                   FontSize="11.5"
                                   Foreground="#949BA6"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="14,0,0,0" />
                    </Grid>

                    <!-- 3 Metric Mini-Columns with Progress Bars -->
                    <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,0,0,14">
                        <!-- Temperature -->
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Temperature" FontSize="11" Foreground="#949BA6" Margin="0,0,0,3" />
                            <TextBlock Text="50 °C"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="#F3F5F8"
                                       FontFamily="Cascadia Mono, JetBrains Mono, Consolas"
                                       Typography.NumeralAlignment="Tabular"
                                       Margin="0,0,0,6" />
                            <ProgressBar Value="50" Minimum="0" Maximum="100" Height="4"
                                         Background="#1A1E29" Foreground="#00FF66" BorderThickness="0" />
                        </StackPanel>

                        <!-- Utilization -->
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Utilization" FontSize="11" Foreground="#949BA6" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding Monitor.GpuUsage, StringFormat={}{0:F0} %}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="#F3F5F8"
                                       FontFamily="Cascadia Mono, JetBrains Mono, Consolas"
                                       Typography.NumeralAlignment="Tabular"
                                       Margin="0,0,0,6" />
                            <ProgressBar Value="{Binding Monitor.GpuUsage}" Minimum="0" Maximum="100" Height="4"
                                         Background="#1A1E29" Foreground="#00FF66" BorderThickness="0" />
                        </StackPanel>

                        <!-- Memory -->
                        <StackPanel>
                            <TextBlock Text="Memory" FontSize="11" Foreground="#949BA6" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding Monitor.GpuVramText}"
                                       FontSize="12.5"
                                       FontWeight="Bold"
                                       Foreground="#F3F5F8"
                                       FontFamily="Cascadia Mono, JetBrains Mono, Consolas"
                                       Typography.NumeralAlignment="Tabular"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,0,6" />
                            <ProgressBar Value="45" Minimum="0" Maximum="100" Height="4"
                                         Background="#1A1E29" Foreground="#00FF66" BorderThickness="0" />
                        </StackPanel>
                    </UniformGrid>

                    <!-- Live Waveform Graph (Stretches vertically with window height) -->
                    <ctrl:TaskManagerGraph Grid.Row="2"
                                           PointsSource="{Binding Monitor.GpuHistory}"
                                           VerticalAlignment="Stretch"
                                           MinHeight="80" />
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 4. BOTTOM ROW: DISK, RAM, NETWORK (3 CARDS STRETCHING TO BOTTOM)          -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= CARD 1: DISK ================= -->
            <Border Grid.Column="0"
                    Style="{StaticResource BentoCardStyle}"
                    Padding="20,16"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Disk"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#F3F5F8"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Monitor.DiskTypeAndModel}"
                                   ToolTip="{Binding Monitor.DiskTypeAndModel}"
                                   FontSize="11"
                                   Foreground="#949BA6"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="10,0,0,0" />
                    </Grid>

                    <!-- Centered KPI: Health 100% -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   Typography.NumeralAlignment="Tabular">
                            <Run Text="Health " Foreground="#F3F5F8" /><Run Text="100%" Foreground="#00FF66" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="#949BA6"
                                   FontFamily="Cascadia Mono, JetBrains Mono, Consolas"
                                   Typography.NumeralAlignment="Tabular"
                                   Margin="0,4,0,0">
                            <Run Text="{Binding Monitor.DiskFreeGb, StringFormat={}{0:F0} GB Free, Mode=OneWay}" /><Run Text=" / " Foreground="#5E6573" /><Run Text="{Binding Monitor.DiskTotalGb, StringFormat={}{0:F0} GB, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <ProgressBar Grid.Row="2"
                                 Value="{Binding Monitor.DiskUsagePercentage}"
                                 Minimum="0" Maximum="100"
                                 Height="4"
                                 Background="#1A1E29"
                                 Foreground="#00FF66"
                                 BorderThickness="0" />
                </Grid>
            </Border>

            <!-- ================= CARD 2: RAM ================= -->
            <Border Grid.Column="2"
                    Style="{StaticResource BentoCardStyle}"
                    Padding="20,16"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="RAM"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#F3F5F8"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Monitor.RamSpeedAndType}"
                                   ToolTip="{Binding Monitor.RamSpeedAndType}"
                                   FontSize="11"
                                   Foreground="#949BA6"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="10,0,0,0" />
                    </Grid>

                    <!-- Centered KPI: Usage XX% -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                   Typography.NumeralAlignment="Tabular">
                            <Run Text="Usage " Foreground="#F3F5F8" /><Run Text="{Binding Monitor.RamUsagePercentage, StringFormat={}{0:F0}%, Mode=OneWay}" Foreground="#00FF66" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="#949BA6"
                                   FontFamily="Cascadia Mono, JetBrains Mono, Consolas"
                                   Typography.NumeralAlignment="Tabular"
                                   Margin="0,4,0,0">
                            <Run Text="{Binding Monitor.RamUsedGb, StringFormat={}{0:F1} GB, Mode=OneWay}" /><Run Text=" / " Foreground="#5E6573" /><Run Text="{Binding Monitor.RamTotalGb, StringFormat={}{0:F0} GB, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <ProgressBar Grid.Row="2"
                                 Value="{Binding Monitor.RamUsagePercentage}"
                                 Minimum="0" Maximum="100"
                                 Height="4"
                                 Background="#1A1E29"
                                 Foreground="#00FF66"
                                 BorderThickness="0" />
                </Grid>
            </Border>

            <!-- ================= CARD 3: NETWORK ================= -->
            <Border Grid.Column="4"
                    Style="{StaticResource BentoCardStyle}"
                    Padding="20,16"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Network"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#F3F5F8"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="Gaming GbE Controller"
                                   FontSize="11"
                                   Foreground="#949BA6"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="10,0,0,0" />
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <!-- Row 1: Total Speed -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Total Speed" FontSize="11" Foreground="#949BA6" />
                            <TextBlock Text="1.0 Gbps"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#F3F5F8"
                                       FontFamily="Cascadia Mono, JetBrains Mono, Consolas" />
                        </Grid>
                        <ProgressBar Value="88" Minimum="0" Maximum="100" Height="4"
                                     Background="#1A1E29" Foreground="#00FF66" BorderThickness="0"
                                     Margin="0,0,0,8" />

                        <!-- Row 2: Nagle / TCP Stack -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="TCP / Nagle Stack" FontSize="11" Foreground="#949BA6" />
                            <TextBlock Text="NoDelay Active"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#00FF66"
                                       FontFamily="Cascadia Mono, JetBrains Mono, Consolas" />
                        </Grid>
                        <ProgressBar Value="100" Minimum="0" Maximum="100" Height="4"
                                     Background="#1A1E29" Foreground="#00FF66" BorderThickness="0"
                                     Margin="0,0,0,8" />

                        <!-- Row 3: DPC / Network Latency -->
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Interrupt Latency" FontSize="11" Foreground="#949BA6" />
                            <TextBlock Text="0.38 ms"
                                       HorizontalAlignment="Right"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#F3F5F8"
                                       FontFamily="Cascadia Mono, JetBrains Mono, Consolas" />
                        </Grid>
                        <ProgressBar Value="94" Minimum="0" Maximum="100" Height="4"
                                     Background="#1A1E29" Foreground="#00FF66" BorderThickness="0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
