    <Style x:Key="SidebarNavRadioStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="SidebarNav" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="navBorder"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,9">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="16" Height="16" Margin="0,0,13,0" VerticalAlignment="Center">
                                <Path x:Name="navIcon"
                                      Width="24" Height="24"
                                      Stretch="None"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Fill="#949BA6" />
                            </Viewbox>
                            <TextBlock x:Name="navText"
                                       Text="{TemplateBinding Content}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#949BA6"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="navBorder" Property="Background" Value="#151821" />
                            <Setter TargetName="navBorder" Property="BorderBrush" Value="#1E222D" />
                            <Setter TargetName="navIcon" Property="Fill" Value="#00FF66" />
                            <Setter TargetName="navText" Property="Foreground" Value="#00FF66" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="navBorder" Property="Background" Value="#101218" />
                            <Setter TargetName="navIcon" Property="Fill" Value="#F3F5F8" />
                            <Setter TargetName="navText" Property="Foreground" Value="#F3F5F8" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="navBorder" Property="Background" Value="#171A24" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
