<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ctrl="clr-namespace:TrueTweaks.Controls"
                    xmlns:helpers="clr-namespace:TrueTweaks.Helpers">

    <!-- ========================================================================= -->
    <!-- 1. OBSIDIAN NEUTRAL & SURGICAL NEON PALETTE (TrueTweaks v2.0.0)           -->
    <!-- ========================================================================= -->

    <!-- Main Window Canvas (Cold Neutral Obsidian - Zero Swamp Green) -->
    <Color x:Key="AppBgColor">#08090C</Color>
    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}" />
    <SolidColorBrush x:Key="AppBackgroundRadialBrush" Color="#08090C" />

    <!-- Sidebar Surface -->
    <Color x:Key="SidebarBgColor">#0A0C10</Color>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" />

    <!-- Bento Card Surfaces (Level 1 & Hover Level 2) -->
    <Color x:Key="CardBgColor">#101218</Color>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource CardBgColor}" />

    <Color x:Key="CardHoverBgColor">#151821</Color>
    <SolidColorBrush x:Key="CardHoverBgBrush" Color="{StaticResource CardHoverBgColor}" />

    <Color x:Key="SurfaceRecessedColor">#0B0D12</Color>
    <SolidColorBrush x:Key="SurfaceRecessedBrush" Color="{StaticResource SurfaceRecessedColor}" />

    <!-- Borders (1px Crisp Neutral & Specular Top Highlight) -->
    <Color x:Key="CardBorderColor">#1E222D</Color>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />

    <LinearGradientBrush x:Key="CardHoverSpecularBorderBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2E3446" Offset="0.0" />
        <GradientStop Color="#181B24" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Surgical Neon Accents (#00FF66 Active / #00CC52 Secondary Rest) -->
    <Color x:Key="AccentCyberColor">#00FF66</Color>
    <SolidColorBrush x:Key="AccentCyberBrush" Color="{StaticResource AccentCyberColor}" />

    <Color x:Key="AccentDarkGreenColor">#00CC52</Color>
    <SolidColorBrush x:Key="AccentDarkGreenBrush" Color="{StaticResource AccentDarkGreenColor}" />

    <!-- Primary CTA Linear Gradient (#00FF66 -> #00D656) -->
    <LinearGradientBrush x:Key="PrimaryAccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00FF66" Offset="0.0" />
        <GradientStop Color="#00D656" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryAccentHoverGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#33FF85" Offset="0.0" />
        <GradientStop Color="#00E65A" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Bottom Fade Mask Gradient (Transparent -> #08090C over 48px) -->
    <LinearGradientBrush x:Key="BottomViewportFadeMaskBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0008090C" Offset="0.0" />
        <GradientStop Color="#D808090C" Offset="0.65" />
        <GradientStop Color="#FF08090C" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Typography Hierarchy -->
    <Color x:Key="TextWhiteColor">#F3F5F8</Color>
    <SolidColorBrush x:Key="TextWhiteBrush" Color="{StaticResource TextWhiteColor}" />

    <Color x:Key="TextMutedColor">#949BA6</Color>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <Color x:Key="TextDimColor">#5E6573</Color>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDimColor}" />

    <!-- Semantic Risk Colors -->
    <Color x:Key="SafeSemanticColor">#00FF66</Color>
    <SolidColorBrush x:Key="SafeSemanticBrush" Color="{StaticResource SafeSemanticColor}" />

    <Color x:Key="WarningColor">#FFB800</Color>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />

    <Color x:Key="DangerColor">#FF3366</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <Color x:Key="InfoColor">#38BDF8</Color>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <!-- Subtle CTA Glow (Strictly reserved for Primary CTA & Active Beacon) -->
    <DropShadowEffect x:Key="PrimaryCtaGlowEffect" Color="#00FF66" BlurRadius="14" ShadowDepth="0" Opacity="0.22" />
    <DropShadowEffect x:Key="PrimaryCtaHoverGlowEffect" Color="#00FF66" BlurRadius="18" ShadowDepth="0" Opacity="0.36" />

    <!-- ========================================================================= -->
    <!-- 2. UNIFIED BADGE COMPONENT STYLES (Optimization Center v2.0.0)            -->
    <!-- ========================================================================= -->

    <!-- Badge 1: Registry Key Badge (#161922 Bg, #262B38 Border, #A0AAB8 Mono) -->
    <Style x:Key="RegistryKeyBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#161922" />
        <Setter Property="BorderBrush" Value="#262B38" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2.5" />
        <Setter Property="Margin" Value="0,0,6,4" />
    </Style>
    <Style x:Key="UnifiedRegistryBadgeStyle" TargetType="Border" BasedOn="{StaticResource RegistryKeyBadgeStyle}" />
    <Style x:Key="UnifiedRegistryBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#A0AAB8" />
        <Setter Property="FontFamily" Value="Cascadia Mono, JetBrains Mono, Consolas" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Badge 2: Impact Badge (rgba(0,255,102,0.08) Bg, rgba(0,255,102,0.25) Border, #00FF66 Text) -->
    <Style x:Key="ImpactBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#1400FF66" />
        <Setter Property="BorderBrush" Value="#4000FF66" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2.5" />
        <Setter Property="Margin" Value="0,0,6,4" />
    </Style>
    <Style x:Key="UnifiedImpactBadgeStyle" TargetType="Border" BasedOn="{StaticResource ImpactBadgeStyle}" />
    <Style x:Key="UnifiedImpactBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#00FF66" />
        <Setter Property="FontFamily" Value="Cascadia Mono, JetBrains Mono, Consolas" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Badge 3: Safety Badge (#181C26 Bg, #262B38 Border, 6px Dot + #E2E8F0 Text) -->
    <Style x:Key="SafetyBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="#181C26" />
        <Setter Property="BorderBrush" Value="#262B38" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2.5" />
        <Setter Property="Margin" Value="0,0,6,4" />
    </Style>
    <Style x:Key="UnifiedSafetyBadgeStyle" TargetType="Border" BasedOn="{StaticResource SafetyBadgeStyle}" />
    <Style x:Key="UnifiedSafetyBadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#E2E8F0" />
        <Setter Property="FontFamily" Value="Cascadia Mono, JetBrains Mono, Consolas" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- 3. BENTO CARD CONTAINER STYLE (Level 1 -> Hover Level 2 Specular)         -->
    <!-- ========================================================================= -->
    <Style x:Key="BentoCardStyle" TargetType="Border">
        <Setter Property="Background" Value="#101218" />
        <Setter Property="BorderBrush" Value="#1E222D" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="helpers:CompositionMotion.EnableCardHover" Value="True" />
    </Style>

    <!-- ========================================================================= -->
    <!-- 4. PAGE TRANSITION STYLE (Opacity 0->1 + Y Slide 12px->0 in 180ms)        -->
    <!-- ========================================================================= -->
    <Style x:Key="SmoothViewEntranceStyle" TargetType="UserControl">
        <Setter Property="helpers:CompositionMotion.EnablePageTransition" Value="True" />
    </Style>

    <!-- ========================================================================= -->
    <!-- 5. BUTTON STYLES (Primary CTA Neon & Obsidian Ghost Secondary)            -->
    <!-- ========================================================================= -->
    <Style x:Key="PrimaryNeonButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryAccentGradient}" />
        <Setter Property="Foreground" Value="#050806" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="helpers:CompositionMotion.EnableClickScale" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource PrimaryCtaGlowEffect}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryAccentHoverGradient}" />
                            <Setter TargetName="border" Property="Effect" Value="{StaticResource PrimaryCtaHoverGlowEffect}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#00CC52" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#1A1D26" />
                            <Setter Property="Foreground" Value="#5E6573" />
                            <Setter TargetName="border" Property="Effect" Value="{x:Null}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Obsidian Button -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#141720" />
        <Setter Property="Foreground" Value="#E2E8F0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderBrush" Value="#242936" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="helpers:CompositionMotion.EnableClickScale" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1B1F2B" />
                            <Setter TargetName="border" Property="BorderBrush" Value="#32394A" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#101218" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Category Filter Pill RadioButton -->
    <Style x:Key="CategoryPillRadioStyle" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="pillBorder"
                            Background="#101218"
                            BorderBrush="#1E222D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,6">
                        <TextBlock x:Name="pillText"
                                   Text="{TemplateBinding Content}"
                                   Foreground="#949BA6"
                                   FontWeight="SemiBold"
                                   FontSize="12" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="pillBorder" Property="Background" Value="#1400FF66" />
                            <Setter TargetName="pillBorder" Property="BorderBrush" Value="#6600FF66" />
                            <Setter TargetName="pillText" Property="Foreground" Value="#00FF66" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="pillBorder" Property="Background" Value="#151821" />
                            <Setter TargetName="pillBorder" Property="BorderBrush" Value="#2E3446" />
                            <Setter TargetName="pillText" Property="Foreground" Value="#F3F5F8" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Window Titlebar Action Buttons -->
    <Style x:Key="WindowActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#949BA6" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="38" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#171A24" />
                            <Setter Property="Foreground" Value="#F3F5F8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowActionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E81123" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- 6. NEON TOGGLE SWITCH (Spring Physics Cursor + Obsidian/Neon States)      -->
    <!-- ========================================================================= -->
    <Style x:Key="NeonToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Track"
                                Width="44"
                                Height="24"
                                CornerRadius="12"
                                Background="#161922"
                                BorderBrush="#262B38"
                                BorderThickness="1">
                            <Canvas Width="44" Height="22" ClipToBounds="True">
                                <Ellipse x:Name="Thumb"
                                         Width="16"
                                         Height="16"
                                         Canvas.Left="3"
                                         Canvas.Top="3"
                                         Fill="#68707E" />
                            </Canvas>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(Canvas.Left)"
                                                         To="23"
                                                         Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <helpers:NaturalSpringEase Damping="7.5" Frequency="11.0" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="Thumb"
                                                        Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                        To="#050806"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"
                                                         Storyboard.TargetProperty="(Canvas.Left)"
                                                         To="3"
                                                         Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <helpers:NaturalSpringEase Damping="7.5" Frequency="11.0" EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ColorAnimation Storyboard.TargetName="Thumb"
                                                        Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                        To="#68707E"
                                                        Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Track" Property="Background" Value="#00FF66" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#00FF66" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="#3A4256" />
                            <Setter TargetName="Track" Property="Background" Value="#1B1F2B" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Alias for backward compatibility across views -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox" BasedOn="{StaticResource NeonToggleSwitchStyle}" />

    <!-- ========================================================================= -->
    <!-- 7. SEGMENTED PILL SELECTOR TEMPLATE (Master Card Mutually Exclusive UI)   -->
    <!-- ========================================================================= -->
    <Style TargetType="{x:Type ctrl:SegmentedPillSelector}">
        <Setter Property="Height" Value="34" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:SegmentedPillSelector}">
                    <Border Background="#0B0D12"
                            BorderBrush="#1E222D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="3">
                        <Grid x:Name="PART_TrackGrid" ClipToBounds="True">
                            <!-- Sliding Animated Pill Indicator -->
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    CornerRadius="6"
                                    Background="#1A1E29"
                                    BorderBrush="#2B3142"
                                    BorderThickness="1" />

                            <!-- Clickable Option Segments -->
                            <UniformGrid x:Name="PART_OptionsPanel"
                                         Rows="1"
                                         HorizontalAlignment="Stretch"
                                         VerticalAlignment="Stretch" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ========================================================================= -->
    <!-- 8. MINIMAL SCROLLBAR (Width=4, CornerRadius=2, #2A303C, Hover-Visible)    -->
    <!-- ========================================================================= -->
    <Style x:Key="MinimalScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="4" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.25" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="thumbBorder"
                                                    Width="4"
                                                    Background="#2A303C"
                                                    CornerRadius="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="thumbBorder" Property="Background" Value="#00CC52" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="1.0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Apply MinimalScrollBar globally -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalScrollBarStyle}" />

    <!-- Cyber ProgressBar -->
    <Style x:Key="CyberProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="#161922" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid x:Name="Root">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00CC52" Offset="0" />
                                    <GradientStop Color="#00FF66" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

