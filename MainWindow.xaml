<Window x:Class="TrueTweaks.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:TrueTweaks.Converters"
        mc:Ignorable="d"
        Title="TrueTweaks" 
        Icon="pack://application:,,,/Assets/tweaks.ico"
        Height="840" Width="1280"
        MinHeight="680" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#08090C"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" 
                      ResizeBorderThickness="6" 
                      CornerRadius="0" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="#08090C">
        <Grid.RowDefinitions>
            <!-- 1. Custom TitleBar -->
            <RowDefinition Height="44" />
            <!-- 2. Main App Viewport (Sidebar + Content) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 1. CYBER-PRECISION OBSIDIAN TITLEBAR (v2.0.0) ================= -->
        <Border Grid.Row="0" 
                Background="#08090C" 
                BorderBrush="#1E222D" 
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="TrueTweaks"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Window Action Buttons (Minimize, Maximize, Close) -->
                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    
                    <Button Style="{StaticResource WindowActionButtonStyle}"
                            Command="{Binding MinimizeWindowCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="—" FontSize="11" Margin="0,0,0,2"/>
                    </Button>

                    <Button Style="{StaticResource WindowActionButtonStyle}"
                            Command="{Binding MaximizeRestoreWindowCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="▢" FontSize="12" />
                    </Button>

                    <Button Style="{StaticResource WindowCloseButtonStyle}"
                            Command="{Binding CloseWindowCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                        <TextBlock Text="✕" FontSize="11" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 2. MAIN BODY (SIDEBAR + CONTENT) ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Navigation Sidebar (248px) -->
                <ColumnDefinition Width="248" />
                <!-- Dynamic Content Viewport -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ULTIMATE-STYLE SIDEBAR: Home + every Optimization section + Tools + profile card -->
            <Border Grid.Column="0"
                    Background="#0A0C10"
                    BorderBrush="#1E222D"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="12,14,12,14" LastChildFill="True">

                    <!-- ===== BOTTOM: Applied counter + User profile card ===== -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                        <TextBlock Margin="4,0,0,8" FontSize="12" Foreground="#949BA6" Typography.NumeralAlignment="Tabular">
                            <Run Text="{Binding Monitor.AppliedTweaksCount, Mode=OneWay}" Foreground="#F3F5F8" FontWeight="SemiBold" /><Run Text="/" /><Run Text="{Binding Monitor.TotalTweaksCount, Mode=OneWay}" /><Run Text=" Tweaks Applied" />
                        </TextBlock>

                        <Button Command="{Binding NavigateCommand}" CommandParameter="SETTINGS" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="profileCard"
                                            Background="#101218"
                                            BorderBrush="#1E222D"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="10,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="36" Height="36"
                                                    CornerRadius="9"
                                                    Background="#151821"
                                                    BorderBrush="#4000FF66"
                                                    BorderThickness="1"
                                                    Margin="0,0,10,0">
                                                <Ellipse Width="26" Height="26" RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="pack://application:,,,/Assets/logo_round.png" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="#F3F5F8"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding AccountPlanText}"
                                                           FontSize="11"
                                                           Foreground="#00CC52"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>

                                            <Viewbox Grid.Column="2" Width="14" Height="14" VerticalAlignment="Center" Margin="6,0,2,0">
                                                <Path x:Name="chevron" Data="M7.41,15.41L12,10.83L16.59,15.41L18,14L12,8L6,14L7.41,15.41Z" Fill="#5E6573" />
                                            </Viewbox>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="profileCard" Property="Background" Value="#151821" />
                                            <Setter TargetName="profileCard" Property="BorderBrush" Value="#262B38" />
                                            <Setter TargetName="chevron" Property="Fill" Value="#F3F5F8" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="profileCard" Property="Background" Value="#171A24" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                    <!-- ===== TOP: Scrollable navigation ===== -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource MinimalScrollBarStyle}" />
                        </ScrollViewer.Resources>
                        <StackPanel>
                            <RadioButton Style="{StaticResource SidebarNavRadioStyle}" Content="Home" Tag="{StaticResource IconHome}"
                                         Command="{Binding NavigateCommand}" CommandParameter="DASHBOARD"
                                         IsChecked="{Binding ActiveViewKey, Converter={StaticResource StringEqualsConverter}, ConverterParameter=DASHBOARD, Mode=OneWay}" />

                            <TextBlock Text="OPTIMIZATIONS" Style="{StaticResource SidebarSectionHeaderStyle}" />

                            <RadioButton Style="{StaticResource SidebarNavRadioStyle}" Content="Kernel &amp; CPU" Tag="{StaticResource IconCpu}"
                                         Command="{Binding NavigateCommand}" CommandParameter="OPT:WINDOWS"
                                         IsChecked="{Binding ActiveViewKey, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OPT:WINDOWS, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SidebarNavRadioStyle}" Content="FPS &amp; Gaming" Tag="{StaticResource IconGaming}"
                                         Command="{Binding NavigateCommand}" CommandParameter="OPT:GAMING"
                                         IsChecked="{Binding ActiveViewKey, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OPT:GAMING, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SidebarNavRadioStyle}" Content="Network &amp; Ping" Tag="{StaticResource IconNetwork}"
                                         Command="{Binding NavigateCommand}" CommandParameter="OPT:NETWORK"
                                         IsChecked="{Binding ActiveViewKey, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OPT:NETWORK, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SidebarNavRadioStyle}" Content="Memory &amp; RAM" Tag="{StaticResource IconMemory}"
                                         Command="{Binding NavigateCommand}" CommandParameter="OPT:MEMORY"
                                         IsChecked="{Binding ActiveViewKey, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OPT:MEMORY, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SidebarNavRadioStyle}" Content="Hardware &amp; MSI" Tag="{StaticResource IconHardware}"
                                         Command="{Binding NavigateCommand}" CommandParameter="OPT:HARDWARE"
                                         IsChecked="{Binding ActiveViewKey, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OPT:HARDWARE, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SidebarNavRadioStyle}" Content="Mouse &amp; USB" Tag="{StaticResource IconInput}"
                                         Command="{Binding NavigateCommand}" CommandParameter="OPT:INPUT"
                                         IsChecked="{Binding ActiveViewKey, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OPT:INPUT, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SidebarNavRadioStyle}" Content="Services &amp; Tasks" Tag="{StaticResource IconServices}"
                                         Command="{Binding NavigateCommand}" CommandParameter="OPT:SERVICES"
                                         IsChecked="{Binding ActiveViewKey, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OPT:SERVICES, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SidebarNavRadioStyle}" Content="Privacy &amp; Telemetry" Tag="{StaticResource IconPrivacy}"
                                         Command="{Binding NavigateCommand}" CommandParameter="OPT:PRIVACY"
                                         IsChecked="{Binding ActiveViewKey, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OPT:PRIVACY, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SidebarNavRadioStyle}" Content="UI &amp; Visuals" Tag="{StaticResource IconVisuals}"
                                         Command="{Binding NavigateCommand}" CommandParameter="OPT:VISUALS"
                                         IsChecked="{Binding ActiveViewKey, Converter={StaticResource StringEqualsConverter}, ConverterParameter=OPT:VISUALS, Mode=OneWay}" />

                            <TextBlock Text="TOOLS" Style="{StaticResource SidebarSectionHeaderStyle}" />

                            <RadioButton Style="{StaticResource SidebarNavRadioStyle}" Content="System Cleaner" Tag="{StaticResource IconCleaner}"
                                         Command="{Binding NavigateCommand}" CommandParameter="CLEANER"
                                         IsChecked="{Binding ActiveViewKey, Converter={StaticResource StringEqualsConverter}, ConverterParameter=CLEANER, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SidebarNavRadioStyle}" Content="Restore Point" Tag="{StaticResource IconRestore}"
                                         Command="{Binding NavigateCommand}" CommandParameter="RESTORE"
                                         IsChecked="{Binding ActiveViewKey, Converter={StaticResource StringEqualsConverter}, ConverterParameter=RESTORE, Mode=OneWay}" />
                            <RadioButton Style="{StaticResource SidebarNavRadioStyle}" Content="Settings" Tag="{StaticResource IconSettings}"
                                         Command="{Binding NavigateCommand}" CommandParameter="SETTINGS"
                                         IsChecked="{Binding ActiveViewKey, Converter={StaticResource StringEqualsConverter}, ConverterParameter=SETTINGS, Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- DYNAMIC VIEWPORT -->
            <Grid Grid.Column="1" Background="#08090C">
                <ContentControl Content="{Binding CurrentView}" Focusable="False" />

                <!-- ================= FLOATING TOAST NOTIFICATIONS ================= -->
                <ItemsControl ItemsSource="{Binding ToastService.ActiveToasts}"
                              HorizontalAlignment="Right" 
                              VerticalAlignment="Bottom" 
                              Margin="0,0,24,20" 
                              Panel.ZIndex="999">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#101218"
                                    BorderBrush="#262B38"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Width="360"
                                    Padding="14,12"
                                    Margin="0,0,0,10">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.65"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="28" Height="28" CornerRadius="8" Background="#161922" BorderBrush="{Binding AccentBrush}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding AccentBrush}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" Foreground="#F3F5F8" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#949BA6" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Button Grid.Column="2" 
                                            Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" 
                                            BorderThickness="0" 
                                            Cursor="Hand"
                                            VerticalAlignment="Top" 
                                            Margin="8,-2,-4,0">
                                        <TextBlock Text="✕" FontSize="10" Foreground="#5E6573"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <!-- ================= 3. MINIMAL PC INSTALLER OVERLAY ================= -->
        <Border Grid.Row="1"
                Background="#F208090C"
                Panel.ZIndex="900"
                Visibility="{Binding IsInstallerVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="370"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#101218"
                    BorderBrush="#1E222D"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32,30">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel>
                    <Ellipse Width="46" Height="46" HorizontalAlignment="Center" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/logo_round.png" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <TextBlock Text="Install TrueTweaks" FontSize="19" FontWeight="SemiBold" Foreground="#F3F5F8" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Add TrueTweaks to your PC and create a desktop shortcut."
                               FontSize="12.5" Foreground="#949BA6" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,22"/>

                    <ProgressBar Value="{Binding InstallProgress}" Minimum="0" Maximum="100" Height="3"
                                 Background="#161922" Foreground="#00FF66" BorderThickness="0" Margin="0,0,0,18"
                                 Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisConverter}}"/>

                    <Button Style="{StaticResource PrimaryNeonButtonStyle}"
                            Command="{Binding InstallToPcCommand}"
                            IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBoolConverter}}"
                            Height="40" Margin="0,0,0,8">
                        <TextBlock Text="Install" FontSize="13.5" FontWeight="SemiBold"/>
                    </Button>

                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding SkipInstallerCommand}"
                            IsEnabled="{Binding IsInstalling, Converter={StaticResource InverseBoolConverter}}"
                            Height="34" BorderThickness="0">
                        <TextBlock Text="Continue portable" FontSize="12" Foreground="#949BA6"/>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= 5. MINIMAL DISCORD SIGN-IN OVERLAY ================= -->
        <Border Grid.Row="1" Grid.RowSpan="2"
                Background="#F208090C"
                Panel.ZIndex="950"
                Visibility="{Binding IsDiscordGateVisible, Converter={StaticResource BoolToVisConverter}}">
            <Border Width="380"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#101218"
                    BorderBrush="#1E222D"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="32,30">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.8"/>
                </Border.Effect>
                <StackPanel>
                    <Ellipse Width="46" Height="46" HorizontalAlignment="Center" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/logo_round.png" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <TextBlock Text="Sign in with Discord" FontSize="19" FontWeight="SemiBold" Foreground="#F3F5F8" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Join our Discord server to unlock TrueTweaks."
                               FontSize="12.5" Foreground="#949BA6" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,22"/>

                    <!-- Primary 1-Click OAuth2 Button -->
                    <Button Style="{StaticResource PrimaryNeonButtonStyle}"
                            Command="{Binding LoginWithDiscordCommand}"
                            IsEnabled="{Binding IsDiscordAuthenticating, Converter={StaticResource InverseBoolConverter}}"
                            Height="40" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Path Data="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994.021-.041.001-.09-.041-.106a13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.929 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.894.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z" Fill="#050806"/>
                            </Viewbox>
                            <TextBlock Text="Continue with Discord" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Secondary Join Server Link Button -->
                    <Button Style="{StaticResource GhostButtonStyle}"
                            Command="{Binding JoinDiscordServerCommand}"
                            Height="36" Margin="0,0,0,16">
                        <TextBlock Text="Join discord.gg/truetweaks" FontSize="12" Foreground="#949BA6"/>
                    </Button>

                    <Border Height="1" Background="#1E222D" Margin="0,0,0,14"/>

                    <!-- Minimal Username / ID Fallback Row -->
                    <TextBlock Text="Or verify by Discord username" FontSize="11" Foreground="#5E6573" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="#08090C" BorderBrush="#1E222D" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,8,0">
                            <TextBox Text="{Binding DiscordUserIdInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" Foreground="#F3F5F8" CaretBrush="#00FF66"
                                     BorderThickness="0" FontSize="12"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                        <Button Grid.Column="1"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding VerifyDiscordByIdCommand}"
                                IsEnabled="{Binding IsDiscordAuthenticating, Converter={StaticResource InverseBoolConverter}}"
                                Padding="14,7">
                            <TextBlock Text="Verify" FontSize="12" Foreground="#F3F5F8"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding DiscordStatusText}"
                               FontSize="11.5"
                               Foreground="#00FF66"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ================= 6. SLEEK STARTUP BOOT INTRO ANIMATION OVERLAY ================= -->
        <Border x:Name="StartupSplashOverlay"
                Grid.Row="1" Grid.RowSpan="2"
                Background="#08090C"
                Panel.ZIndex="2000">
            <Grid>
                <!-- Subtle breathing neon radial glow -->
                <Ellipse x:Name="SplashGlowAura"
                         Width="360" Height="360"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Opacity="0"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="SplashGlowScale" ScaleX="0.8" ScaleY="0.8"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#1400FF66" Offset="0.0"/>
                            <GradientStop Color="#0500FF66" Offset="0.55"/>
                            <GradientStop Color="#00000000" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- Centered Logo + Brand + Minimal Progress Line -->
                <StackPanel x:Name="SplashCenterStack"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            RenderTransformOrigin="0.5,0.5">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="SplashContentScale" ScaleX="0.92" ScaleY="0.92"/>
                            <TranslateTransform x:Name="SplashContentTranslate" Y="12"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>

                    <!-- Circular Logo -->
                    <Ellipse x:Name="SplashLogoBox"
                             Width="68" Height="68"
                             HorizontalAlignment="Center"
                             Margin="0,0,0,16"
                             Opacity="0"
                             RenderTransformOrigin="0.5,0.5"
                             RenderOptions.BitmapScalingMode="HighQuality">
                        <Ellipse.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="SplashLogoScale" ScaleX="0.75" ScaleY="0.75"/>
                                <RotateTransform x:Name="SplashLogoRotate" Angle="-45"/>
                            </TransformGroup>
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="pack://application:,,,/Assets/logo_round.png" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Brand Name -->
                    <TextBlock x:Name="SplashBrandTitle"
                               Text="TrueTweaks"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#F3F5F8"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"
                               Opacity="0">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="SplashTitleTranslate" Y="8"/>
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <!-- Razor-thin animated progress bar -->
                    <Border Width="148" Height="2"
                            CornerRadius="1"
                            Background="#1E222D"
                            HorizontalAlignment="Center"
                            ClipToBounds="True">
                        <Border x:Name="SplashProgressFill"
                                Width="0" Height="2"
                                CornerRadius="1"
                                HorizontalAlignment="Left"
                                Background="#00FF66"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
